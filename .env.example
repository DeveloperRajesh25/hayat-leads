# ===========================================================================
# Hayat Interiors — WhatsApp Lead Automation
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`.
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API)
# ---------------------------------------------------------------------------
# Public, safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only — NEVER expose this. Bypasses Row Level Security.
# Used by public form submission + campaign sending API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL of this deployment (used to build the customer form link
# that is sent inside the WhatsApp message). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API  (Meta -> developers.facebook.com)
# ---------------------------------------------------------------------------
# Server only secrets:
WHATSAPP_ACCESS_TOKEN=your-permanent-or-temporary-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
# Graph API version, e.g. v21.0
WHATSAPP_API_VERSION=v21.0
# A random string you choose; must match what you enter in the Meta webhook UI.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-long-random-string

# Public (non-secret) WhatsApp template configuration.
# Create this template in WhatsApp Manager first (see README).
NEXT_PUBLIC_WHATSAPP_TEMPLATE_NAME=hayat_interiors_intro
NEXT_PUBLIC_WHATSAPP_TEMPLATE_LANG=en
# Predefined image sent in the template header (must be a public https URL).
# Only needed if your template's header format is IMAGE.
NEXT_PUBLIC_WHATSAPP_IMAGE_URL=https://YOUR-PROJECT-ref.supabase.co/storage/v1/object/public/assets/hayat-banner.jpg

# Default country code applied to local phone numbers that have none.
# 91 = India, 971 = UAE, 966 = Saudi Arabia, etc. Digits only, no "+".
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91
