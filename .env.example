# ===========================================================================
# Hayat Interiors — WhatsApp Lead Automation
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`.
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API)
# ---------------------------------------------------------------------------
# Public, safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only — NEVER expose this. Bypasses Row Level Security.
# Used by public form submission + campaign sending API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL of this deployment (used to build the customer form link
# that is sent inside the WhatsApp message). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API  (Meta -> developers.facebook.com)
# ---------------------------------------------------------------------------
# Server only secrets:
WHATSAPP_ACCESS_TOKEN=your-permanent-or-temporary-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Required for the campaign page's template picker — it lists the approved
# templates on this WhatsApp Business Account.
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
# Graph API version, e.g. v21.0
WHATSAPP_API_VERSION=v21.0
# A random string you choose; must match what you enter in the Meta webhook UI.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-long-random-string
# Two-step verification PIN for this number. Only needed to call POST
# /api/whatsapp/register (e.g. after a display name change is approved).
# If this number has never had two-step verification enabled, choose any new
# 6-digit PIN yourself — the register call sets it as the number's PIN going
# forward, it isn't recovering an existing one.
WHATSAPP_TWO_STEP_PIN=your-6-digit-pin
# Random secret you choose, required as the x-register-secret header when
# calling POST /api/whatsapp/register. Not related to the WhatsApp PIN above.
WHATSAPP_REGISTER_SECRET=choose-a-long-random-string

# Public (non-secret) WhatsApp template configuration.
# Which template the campaign form pre-selects. Every approved template on the
# WABA is offered in the picker, so this is only the default — not a limit.
NEXT_PUBLIC_WHATSAPP_TEMPLATE_NAME=hayat_interiors_intro
NEXT_PUBLIC_WHATSAPP_TEMPLATE_LANG=en
# Default image prefilled for templates with an IMAGE header (public https URL).
# Templates with a VIDEO header need their own URL entered in the campaign form;
# templates with a TEXT header or no header ignore this entirely.
NEXT_PUBLIC_WHATSAPP_IMAGE_URL=https://YOUR-PROJECT-ref.supabase.co/storage/v1/object/public/assets/hayat-banner.jpg

# Default country code applied to local phone numbers that have none.
# 91 = India, 971 = UAE, 966 = Saudi Arabia, etc. Digits only, no "+".
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91

# ---------------------------------------------------------------------------
# Campaign auto-completion (recommended)
# ---------------------------------------------------------------------------
# A campaign finishes on its own via a server-side chain, but a cron is the
# guaranteed backstop: it re-ignites any campaign still "sending" with pending
# recipients, so a large send always completes even if the tab is closed.
#
# A GitHub Actions workflow (.github/workflows/advance-campaigns.yml) pings
# /api/cron/advance-campaigns every ~5 minutes. Set CRON_SECRET to the SAME
# value in BOTH places:
#   - here / Vercel env  -> so the endpoint knows the expected secret
#   - GitHub repo secret -> so the workflow sends it (Settings -> Secrets and
#     variables -> Actions -> New repository secret, name CRON_SECRET)
CRON_SECRET=choose-a-long-random-string
